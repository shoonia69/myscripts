# Адрес панели вместе с web base path, если он настроен.
XUI_PANEL_URL=https://panel.example.com:2053/secret-path/

# Предпочтительно: Settings -> Security -> API Token.
XUI_API_TOKEN=replace-with-panel-api-token
# Для старых панелей без API Token удалите XUI_API_TOKEN и задайте:
# XUI_USERNAME=admin
# XUI_PASSWORD=replace-with-panel-password

# Все текущие и будущие inbound.
XUI_INBOUND_IDS=all

# auto поддерживает новый API клиентов и старый /inbounds/addClient.
XUI_API_MODE=auto

# Публичный базовый URL сервера подписок 3x-ui. Завершающий / допустим.
XUI_SUBSCRIPTION_BASE_URL=https://sub.example.com/sub/

# Сгенерируйте: openssl rand -hex 32. Не меняйте после запуска:
# от него зависят стабильные идентификаторы клиентов.
APP_SECRET=replace-with-at-least-32-random-characters

SITE_TITLE=Получить доступ
RATE_LIMIT_PER_HOUR=10
XUI_VERIFY_TLS=true
XUI_REQUEST_TIMEOUT=15

# 0 означает без ограничения.
CLIENT_TOTAL_GB=0
CLIENT_EXPIRY_DAYS=0
CLIENT_LIMIT_IP=0
CLIENT_FLOW=
